# Evergreen application settings. Every required value must be filled in.
# No values are inferred from Pi settings or ambient model environment variables.
# Paths: absolute or ~/... . Timezone: an IANA timezone name.
PI-EXTENSIONS-DIR=
PI-GITHUB-OWNER=

# Required format: provider/model/reasoning-level
# Example maintenance selection: openai/gpt-6.1-sol/medium
# Choose your cheapest suitable model for e2e, for example gpt-6-luna.
# Reasoning: off, minimal, low, medium, high, xhigh, or max.
PI-AGENT-MODEL=
PI-E2E-MODEL=

PI-TIMEZONE=
# Integer 1..8.
PI-CONCURRENCY=
# Positive integer milliseconds, at least 1000.
PI-COMMAND-TIMEOUT-MS=
PI-AGENT-TIMEOUT-MS=
# public or restricted.
PI-PUBLISH-ACCESS=

# Test-command entries are generated by the first-run extension agents.
# No manual mapping is required. Each later audit keeps its own entry current.
